{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview-nosignal": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_SIGNAL_DETECTION": "false"
      }
    },
    "production": {
      "autoIncrement": true
    },
    "production-nosignal": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_SIGNAL_DETECTION": "false"
      }
    }
  }
}
