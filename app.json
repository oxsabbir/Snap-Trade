{
  "expo": {
    "name": "SnapTrade",
    "slug": "snaptrade",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/branding/app-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oxsabbir.snaptrade",
      "buildNumber": "4",
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "package": "com.oxsabbir.snaptrade",
      "versionCode": 4,
      "userInterfaceStyle": "automatic",
      "adaptiveIcon": {
        "backgroundColor": "#4782FF",
        "foregroundImage": "./assets/branding/adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/branding/app-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#121212",
            "image": "./assets/branding/app-icon.png"
          }
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": false
        }
      ]
    ]
  }
}
