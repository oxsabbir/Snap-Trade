{
  "expo": {
    "name": "SnapTrade",
    "slug": "snaptrade",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/app-icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oxsabbir.snaptrade"
    },
    "android": {
      "package": "com.oxsabbir.snaptrade",
      "adaptiveIcon": {
        "backgroundColor": "#4782FF",
        "foregroundImage": "./assets/branding/adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#061950",
          "image": "./assets/branding/app-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
