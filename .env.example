# These are NOT read by the app.
#
# The KuCoin API key is entered at runtime on the Account tab and stored in the device
# keystore via expo-secure-store. Nothing secret is loaded from .env or baked into the
# bundle, so a cloud EAS build needs no local .env at all.
#
# This file is kept only as a note for a future signing proxy: if you ever distribute
# this app, the keys belong in that server's environment, not here.
#
# Create keys at https://www.kucoin.com/profile/apikey/new
#   - Enable "General" (read) only.
#   - Leave Spot Trading and Withdrawal OFF.
#
# Market data (/api/v1/symbols, /api/v1/market/allTickers) is public and needs no keys.
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=
